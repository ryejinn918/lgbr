{
  "name": "sector-consensus",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "pm2:start": "pnpm build && pm2 start ../../ecosystem.config.cjs --only sector-consensus",
    "pm2:restart": "pnpm build && pm2 restart sector-consensus",
    "pm2:stop": "pm2 stop sector-consensus",
    "pm2:logs": "pm2 logs sector-consensus"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
